# server
NODE_ENV=development
PORT=3000

# database
DATABASE_URL=mysql://user:password@localhost:3306/outdoor

# jwt
JWT_SECRET=replace-with-random-string
JWT_EXPIRES_IN=7d

# wechat miniapp
WECHAT_APPID=wx0000000000000000
WECHAT_SECRET=replace-with-secret

# wechat pay
WECHAT_PAY_MCHID=1900000000
WECHAT_PAY_SERIAL_NO=replace-with-serial
WECHAT_PAY_PRIVATE_KEY_PATH=./cert/apiclient_key.pem
WECHAT_PAY_API_V3_KEY=replace-with-32-char-key

# oss
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=outdoor-uploads
OSS_ACCESS_KEY_ID=replace
OSS_ACCESS_KEY_SECRET=replace
